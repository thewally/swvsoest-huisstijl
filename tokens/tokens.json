      { "name": "vvz-groen", "value": { "light": "#35A044", "dark": "#35A044" }, "usage": "Het groen van VVZ'49, linkerhelft van het logo. Voor grote kleurvlakken, banden en illustraties; niet voor kleine witte tekst erop (3,35:1). Witte tekst hierop alleen vanaf 24px of 19px vet." },
      { "name": "so-blauw", "value": { "light": "#1B4F91", "dark": "#1B4F91" }, "usage": "Het blauw van So Soest, rechterhelft van het logo. Voor grote kleurvlakken en banden; witte tekst erop is in elk formaat leesbaar (8,2:1)." },
      { "name": "navy", "value": { "light": "#0B2A52", "dark": "#0B2A52" }, "usage": "Donkerblauw van de schildrand en het SOEST-lint. Voor de footer, het lint-motief en donkere banden; witte tekst erop (14:1)." },
      { "name": "surface", "value": { "light": "#FFFFFF", "dark": "#0A1A33" }, "usage": "Paginaachtergrond." },
      { "name": "surface-alt", "value": { "light": "#F4F5F3", "dark": "#0F2342" }, "usage": "Afwisselende sectieachtergrond." },
      { "name": "surface-raised", "value": { "light": "#FFFFFF", "dark": "#12284A" }, "usage": "Kaarten en panelen boven surface of surface-alt." },
      { "name": "ink", "value": { "light": "#0B2A52", "dark": "#EEF2F7" }, "usage": "Lopende tekst en koppen op surface, surface-alt en surface-raised." },
      { "name": "ink-muted", "value": { "light": "#4A5A6E", "dark": "#A9B6C8" }, "usage": "Secundaire tekst (datum, bijschrift, meta) op surface, surface-alt en surface-raised." },
      { "name": "line", "value": { "light": "#D0D7DE", "dark": "#2A4063" }, "usage": "Scheidingslijnen en kaartranden; decoratief." },
      { "name": "line-strong", "value": { "light": "#7A8898", "dark": "#6A83A3" }, "usage": "Randen van invoervelden en bedieningselementen (minstens 3:1)." },
      { "name": "groen-actie", "value": { "light": "#1F7A34", "dark": "#6CCB78" }, "usage": "Primaire knoppen en links in het groen; ook als tekst op surface en surface-alt." },
      { "name": "on-groen-actie", "value": { "light": "#FFFFFF", "dark": "#0A1A33" }, "usage": "Tekst en iconen op een groen-actie-vlak." },
      { "name": "blauw-actie", "value": { "light": "#1B4F91", "dark": "#8DB3E8" }, "usage": "Secundaire knoppen en links; ook als tekst op surface en surface-alt." },
      { "name": "on-blauw-actie", "value": { "light": "#FFFFFF", "dark": "#0A1A33" }, "usage": "Tekst en iconen op een blauw-actie-vlak." },
      { "name": "groen-zacht", "value": { "light": "#E4F3E6", "dark": "#12351F" }, "usage": "Lichte groene achtergrond voor badges; tekst erop in groen-actie." },
      { "name": "blauw-zacht", "value": { "light": "#E6EEF8", "dark": "#16305A" }, "usage": "Lichte blauwe achtergrond voor badges en infoblokken; tekst erop in blauw-actie." },
      { "name": "focus-ring", "value": { "light": "#1B4F91", "dark": "#F5B971" }, "usage": "Toetsenbordfocus: 2px ring met 2px afstand." },
      { "name": "danger", "value": { "light": "#B42318", "dark": "#FF8A80" }, "usage": "Foutmeldingen en afgelastingen; altijd met een woord erbij." },
      { "name": "warning", "value": { "light": "#B54708", "dark": "#F5B971" }, "usage": "Waarschuwingen, zoals een gewijzigde aanvangstijd; altijd met een woord erbij." },
      { "name": "success", "value": { "light": "{groen-actie}", "dark": "{groen-actie}" }, "usage": "Bevestigingen." }
